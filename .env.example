# ─────────────────────────────────────────────────────────────
#  Copy to .env.local and fill in. .env.local is gitignored.
#
#  Without RESEND_API_KEY and CONTACT_FROM_EMAIL the contact form
#  deliberately fails with a visible message telling visitors to
#  email you directly — it never pretends an enquiry was delivered.
# ─────────────────────────────────────────────────────────────

# https://resend.com — free tier covers a marketing site comfortably
RESEND_API_KEY=

# Must be an address on a domain you have verified in Resend
CONTACT_FROM_EMAIL=website@rayonintel.com

# Where enquiries land. Defaults to site.contact.email if unset.
CONTACT_TO_EMAIL=
